*.elf
*.hex
*.bin
*.out

# Listing files
*.lst
*.map

# Dependency files
*.d
remote_mic_tx_raw/

# 抓包 / 测量导出的数据（KVASER 等）
*.kvdat

# 根目录的临时数据导出 —— 只忽略根目录：
# docs/、.claude/skills/ 等子目录下正经跟踪的 .txt/.csv 不受影响（已有 23 个）。
# 若以后要加根目录的数据文件，用 git add -f。
/*.txt
/*.csv
